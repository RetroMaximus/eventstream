# eventstream - copy to .env and edit.

EVENTSTREAM_ROOT=.
EVENTSTREAM_APP_NAME=eventstream
EVENTSTREAM_ENV=development
EVENTSTREAM_DEBUG=true
EVENTSTREAM_HOST=0.0.0.0
EVENTSTREAM_PORT=8080

# base64 of 32+ random bytes. generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
EVENTSTREAM_MASTER_KEY=REPLACE_ME
EVENTSTREAM_SESSION_SECRET=REPLACE_ME
EVENTSTREAM_SESSION_TTL=86400

EVENTSTREAM_VAR_DIR=./var
EVENTSTREAM_LOG_LEVEL=INFO
EVENTSTREAM_LOG_MAX_BYTES=5242880
EVENTSTREAM_LOG_BACKUP_COUNT=5

