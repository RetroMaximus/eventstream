# eventstream - copy to ~/.config/eventstream/eventstream.env and edit.
# This file is tracked in git. Never put real secrets here.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
EVENTSTREAM_ROOT=.
EVENTSTREAM_APP_NAME=eventstream
EVENTSTREAM_ENV=development
EVENTSTREAM_DEBUG=true
EVENTSTREAM_HOST=0.0.0.0
EVENTSTREAM_PORT=8080
EVENTSTREAM_PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Secrets (base64 of 32+ random bytes)
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------
EVENTSTREAM_MASTER_KEY=REPLACE_ME
EVENTSTREAM_SESSION_SECRET=REPLACE_ME
EVENTSTREAM_SESSION_TTL=86400

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
EVENTSTREAM_VAR_DIR=./var

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
EVENTSTREAM_LOG_LEVEL=INFO
EVENTSTREAM_LOG_MAX_BYTES=5242880
EVENTSTREAM_LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Cookies and sessions
# ---------------------------------------------------------------------------
EVENTSTREAM_COOKIE_NAME=eventstream_session
EVENTSTREAM_COOKIE_SAMESITE=Lax
# Default: false in development, true in production. Override only if needed.
# EVENTSTREAM_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
EVENTSTREAM_RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# SMTP (leave host blank to log emails instead of sending them)
# ---------------------------------------------------------------------------
EVENTSTREAM_SMTP_ENABLED=false
EVENTSTREAM_SMTP_HOST=
EVENTSTREAM_SMTP_PORT=587
EVENTSTREAM_SMTP_USER=
EVENTSTREAM_SMTP_PASSWORD=
EVENTSTREAM_SMTP_FROM=eventstream@localhost
EVENTSTREAM_SMTP_TLS=true

# ---------------------------------------------------------------------------
# Twitch OAuth
# ---------------------------------------------------------------------------
EVENTSTREAM_TWITCH_CLIENT_ID=
EVENTSTREAM_TWITCH_CLIENT_SECRET=
EVENTSTREAM_TWITCH_REDIRECT_URI=http://localhost:8080/auth/twitch/callback
EVENTSTREAM_TWITCH_SCOPES=user:read:email,chat:read,chat:edit,clips:edit,channel:read:stream_key,channel:manage:broadcast

# ---------------------------------------------------------------------------
# Google / YouTube OAuth
# ---------------------------------------------------------------------------
EVENTSTREAM_GOOGLE_CLIENT_ID=
EVENTSTREAM_GOOGLE_CLIENT_SECRET=
EVENTSTREAM_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
EVENTSTREAM_GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/youtube.force-ssl